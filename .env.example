# ============================================================
# Variables de Entorno - API Role Service
# ============================================================
# IMPORTANTE: Este es un archivo de ejemplo.
# NO commitees el archivo .env real con valores de producción.
# Copia este archivo como .env y completa los valores reales.
# ============================================================

# Keycloak Server Configuration
KEYCLOAK_URL=http://localhost:8083/
KEYCLOAK_REALM=billpay_app

# Client Credentials (Service Account con permisos administrativos completos)
# Este cliente debe tener habilitado "Service accounts roles" y 
# permisos de realm-management asignados
KEYCLOAK_CLIENT_ID=cli_billpay_app
KEYCLOAK_CLIENT_SECRET=CAMBIAR_POR_SECRET_REAL_GENERADO_EN_KEYCLOAK

# ============================================================
# Instrucciones:
# ============================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con los valores reales
# 3. Asegúrate de que .env esté en .gitignore
# 4. Configura el cliente en Keycloak:
#    - Clients -> cli_billpay_app -> Settings
#    - Client authentication: ON
#    - Service accounts roles: ENABLED
#    - Service account roles -> Assign roles -> realm-management
#      * Asigna todos los permisos necesarios:
#        - manage-realm (gestionar roles y configuración)
#        - manage-users (gestionar usuarios)
#        - manage-clients (gestionar clientes)
#        - view-realm, view-users, view-clients
# 5. Obtén el Client Secret de: Credentials tab
# ============================================================

# Ejemplo de exportación para desarrollo local:
# export $(cat .env | grep -v '^#' | xargs)
