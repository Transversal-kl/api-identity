# ============================================================
# Variables de Entorno - API Role Service
# ============================================================
# IMPORTANTE: Este es un archivo de ejemplo.
# NO commitees el archivo .env real con valores de producción.
# Copia este archivo como .env y completa los valores reales.
# ============================================================

# ===============================================
# POSTGRESQL DATABASE CONFIGURATION
# ===============================================
# Configuración de la base de datos PostgreSQL para sincronización de usuarios
# y almacenamiento de profile images

DB_KIND=postgresql
DB_USERNAME=user_account
DB_PASSWORD=1234
DB_JDBC_URL=postgresql://localhost:5433/db_keycloak
DB_REACTIVE_URL=postgresql://localhost:5433/db_keycloak

# Pool de conexiones reactivas
DB_REACTIVE_MAX_SIZE=20

# ===============================================
# KEYCLOAK SERVER CONFIGURATION
# ===============================================
KEYCLOAK_URL=http://localhost:8083/
KEYCLOAK_REALM=billpay_app

# ===============================================
# KEYCLOAK ADMIN CLIENT (Backend Authentication)
# ===============================================
# Credenciales del cliente para autenticación backend usando CLIENT_CREDENTIALS
# Este cliente debe tener "Service accounts roles" habilitado y
# permisos de realm-management asignados

KEYCLOAK_CLIENT_ID=cli_billpay_app
KEYCLOAK_CLIENT_SECRET=CAMBIAR_POR_SECRET_REAL_GENERADO_EN_KEYCLOAK

# ===============================================
# OIDC JWT AUTHENTICATION (Protección de Endpoints)
# ===============================================
# Las mismas credenciales se usan para validación de tokens JWT.
# Todos los endpoints REST requieren un JWT válido con roles apropiados:
#
# Roles disponibles:
# - admin: Acceso completo (crear, leer, actualizar, eliminar)
# - role-manager: Gestionar roles (crear, leer, actualizar)
# - viewer: Acceso solo lectura
#
# Para probar la API:
# 1. Obtener un token JWT (ver comandos abajo)
# 2. Incluirlo en header Authorization: "Bearer <token>"
# 3. Sin token válido, los endpoints retornan 401 Unauthorized
#
# Cómo obtener un token JWT:
#
# Opción A - Password Grant (autenticación de usuario):
# curl -X POST "http://localhost:8083/realms/billpay_app/protocol/openid-connect/token" \
#   -H "Content-Type: application/x-www-form-urlencoded" \
#   -d "client_id=cli_billpay_app" \
#   -d "client_secret=TU_CLIENT_SECRET" \
#   -d "grant_type=password" \
#   -d "username=tu-usuario" \
#   -d "password=tu-password"
#
# Opción B - Client Credentials (servicio a servicio):
# curl -X POST "http://localhost:8083/realms/billpay_app/protocol/openid-connect/token" \
#   -H "Content-Type: application/x-www-form-urlencoded" \
#   -d "client_id=cli_billpay_app" \
#   -d "client_secret=TU_CLIENT_SECRET" \
#   -d "grant_type=client_credentials"
#
# Ejemplo de llamada a la API con token JWT:
# curl -X GET "http://localhost:8080/roles" \
#   -H "Authorization: Bearer TU_JWT_TOKEN_AQUI"

# ============================================================
# INSTRUCCIONES DE CONFIGURACIÓN EN KEYCLOAK:
# ============================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con los valores reales
# 3. Asegúrate de que .env esté en .gitignore
# 4. Configura el cliente en Keycloak:
#    - Clients -> cli_billpay_app -> Settings
#    - Client authentication: ON
#    - Service accounts roles: ENABLED
#    - Service account roles -> Assign roles -> realm-management
#      * Asigna todos los permisos necesarios:
#        - manage-realm (gestionar roles y configuración)
#        - manage-users (gestionar usuarios)
#        - manage-clients (gestionar clientes)
#        - view-realm, view-users, view-clients
# 5. Obtén el Client Secret de: Credentials tab
# 6. Crea los roles de aplicación: admin, role-manager, viewer
# 7. Asigna roles a usuarios o al service account según necesites
# ============================================================

# ============================================================
# INSTRUCCIONES DE CONFIGURACIÓN EN POSTGRESQL:
# ============================================================
# 1. Crea la base de datos billpay_db:
#    createdb -U postgres billpay_db
#
# 2. Crea el usuario y otorga permisos:
#    psql -U postgres
#    CREATE USER billpay_user WITH PASSWORD 'tu_password_seguro';
#    GRANT ALL PRIVILEGES ON DATABASE billpay_db TO billpay_user;
#    \c billpay_db
#    GRANT ALL ON SCHEMA public TO billpay_user;
#
# 3. La tabla user_account se creará automáticamente por Hibernate
#    con la siguiente estructura:
#    - id: UUID (PK)
#    - username: VARCHAR(255) UNIQUE NOT NULL
#    - email: VARCHAR(255) UNIQUE NOT NULL
#    - first_name: VARCHAR(255)
#    - last_name: VARCHAR(255)
#    - profile_image: BYTEA
#    - created_at: TIMESTAMP WITH TIME ZONE
# ============================================================

# Exportar variables para desarrollo local:
# export $(cat .env | grep -v '^#' | xargs)
